{
  "name": "appstore-connect-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for App Store Connect. Credentials from env only, JWT signed locally, direct-to-Apple. Fork of ryaker/appstore-connect-mcp with all hosted/OAuth/Supabase infra removed.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "appstore-connect-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "author": "Ryan Aker (original), Petro Pentsak (fork)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/petropentsak/appstore-connect-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple",
    "app-store-connect",
    "ios"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
